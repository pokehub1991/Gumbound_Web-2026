# Build stage
FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY apps/server/go.mod apps/server/go.sum ./
RUN go mod download

COPY apps/server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /gumbound-server main.go

# Production runtime stage
FROM alpine:3.20

WORKDIR /root/
COPY --from=builder /gumbound-server ./server

EXPOSE 8080
CMD ["./server"]
