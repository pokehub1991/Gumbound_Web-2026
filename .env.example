# Gumbound S2 — plantilla de entorno. Copiar a .env y rellenar.
# Nunca commitear .env real (ya está en .gitignore).

# Requerido: clave de firma JWT (mínimo 32 caracteres).
JWT_SECRET=

# Contraseña de Postgres dev (rotar respecto al valor anterior "dev").
POSTGRES_USER=gumbound
POSTGRES_PASSWORD=
POSTGRES_DB=gumbound_dev

# Origen(es) permitidos para CORS y WS. Separar por comas.
# Vacío = permisivo SOLO si GO_ENV != production.
ALLOWED_ORIGIN=http://localhost:3000

# production activa restricciones duras de origen y avisa si no hay TLS.
GO_ENV=development

# Terminación TLS opcional en el propio binario (si no, usar reverse proxy).
TLS_CERT=
TLS_KEY=

# 1 = crear cuentas player1/player2/admin para desarrollo local.
SEED_ACCOUNTS=0
